BOT_TOKEN=
TELEGRAM_API_BASE=https://telegram-api-proxy.tolya200059.workers.dev
TELEGRAM_PROXY_SECRET=

POSTGRES_DB=dating
POSTGRES_USER=dating
POSTGRES_PASSWORD=
# Only used outside Docker Compose:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ADMIN_USER=admin
# At least 16 characters; use a separate random password:
ADMIN_PASSWORD=
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080

# Public path in Nginx; empty value restores root URLs:
ADMIN_BASE_PATH=/admin
# Only the IP(s) of your reverse proxy. For Docker, add its observed host gateway /32.
ADMIN_TRUSTED_PROXIES=127.0.0.1/32,::1/128
